# Minimal static-library build for the bundled IJG JPEG 6b sources.
# It deliberately builds only the library required by WinDjView.

CPP = cl
LIB = lib

!IFDEF X64
MACHINE = X64
SUFFIX = 64
WINTYPE = /D"WIN32" /D"WIN64"
!ELSE
MACHINE = X86
SUFFIX =
WINTYPE = /D"WIN32"
!ENDIF

INTDIR = .\Objs$(SUFFIX)
OUT = jpeg$(SUFFIX).lib
OPTS = /nologo /c /MT /O2 /GL /W3 /D"NDEBUG" $(WINTYPE) /Fo"$(INTDIR)\\"

OBJS = "$(INTDIR)\jcapimin.obj" \
       "$(INTDIR)\jcapistd.obj" \
       "$(INTDIR)\jccoefct.obj" \
       "$(INTDIR)\jccolor.obj" \
       "$(INTDIR)\jcdctmgr.obj" \
       "$(INTDIR)\jchuff.obj" \
       "$(INTDIR)\jcinit.obj" \
       "$(INTDIR)\jcmainct.obj" \
       "$(INTDIR)\jcmarker.obj" \
       "$(INTDIR)\jcmaster.obj" \
       "$(INTDIR)\jcomapi.obj" \
       "$(INTDIR)\jcparam.obj" \
       "$(INTDIR)\jcphuff.obj" \
       "$(INTDIR)\jcprepct.obj" \
       "$(INTDIR)\jcsample.obj" \
       "$(INTDIR)\jctrans.obj" \
       "$(INTDIR)\jdapimin.obj" \
       "$(INTDIR)\jdapistd.obj" \
       "$(INTDIR)\jdtrans.obj" \
       "$(INTDIR)\jdatadst.obj" \
       "$(INTDIR)\jdatasrc.obj" \
       "$(INTDIR)\jdcoefct.obj" \
       "$(INTDIR)\jdcolor.obj" \
       "$(INTDIR)\jddctmgr.obj" \
       "$(INTDIR)\jdhuff.obj" \
       "$(INTDIR)\jdinput.obj" \
       "$(INTDIR)\jdmainct.obj" \
       "$(INTDIR)\jdmarker.obj" \
       "$(INTDIR)\jdmaster.obj" \
       "$(INTDIR)\jdmerge.obj" \
       "$(INTDIR)\jdphuff.obj" \
       "$(INTDIR)\jdpostct.obj" \
       "$(INTDIR)\jdsample.obj" \
       "$(INTDIR)\jerror.obj" \
       "$(INTDIR)\jfdctflt.obj" \
       "$(INTDIR)\jfdctfst.obj" \
       "$(INTDIR)\jfdctint.obj" \
       "$(INTDIR)\jidctflt.obj" \
       "$(INTDIR)\jidctfst.obj" \
       "$(INTDIR)\jidctint.obj" \
       "$(INTDIR)\jidctred.obj" \
       "$(INTDIR)\jquant1.obj" \
       "$(INTDIR)\jquant2.obj" \
       "$(INTDIR)\jutils.obj" \
       "$(INTDIR)\jmemmgr.obj" \
       "$(INTDIR)\jmemnobs.obj"

all: $(OUT)

clean:
	@if exist "$(INTDIR)\*.obj" del /q /f "$(INTDIR)\*.obj"
	@if exist "$(OUT)" del /q /f "$(OUT)"

$(OUT): "$(INTDIR)" $(OBJS)
	@$(LIB) /nologo /ltcg /machine:$(MACHINE) /out:$(OUT) $(OBJS)

.c{$(INTDIR)}.obj::
	@$(CPP) $(OPTS) $<

"$(INTDIR)":
	@if not exist "$(INTDIR)" mkdir "$(INTDIR)"
